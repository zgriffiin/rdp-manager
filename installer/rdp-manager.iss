; Inno Setup script for RDP Manager. Build with installer\build.ps1, which passes
; AppVersion (from Cargo.toml) and AppIcon (generated by build.rs).

#ifndef AppVersion
  #error Pass /DAppVersion=x.y.z
#endif

[Setup]
AppId={{4AD11AE1-B008-4D4A-AEA9-89E08D181B5D}
AppName=RDP Manager
AppVersion={#AppVersion}
AppVerName=RDP Manager {#AppVersion}
AppPublisher=zgriffiin
AppPublisherURL=https://github.com/zgriffiin/rdp-manager
AppSupportURL=https://github.com/zgriffiin/rdp-manager/issues
VersionInfoVersion={#AppVersion}
; Installs for the current user without admin rights; admins can choose all users.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog commandline
DefaultDirName={autopf}\RDP Manager
DisableProgramGroupPage=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
#ifdef AppIcon
SetupIconFile={#AppIcon}
#endif
UninstallDisplayIcon={app}\rdp-manager.exe
UninstallDisplayName=RDP Manager
WizardStyle=modern
Compression=lzma2
SolidCompression=yes
OutputDir=..\target\installer
OutputBaseFilename=rdp-manager-{#AppVersion}-setup

[Tasks]
Name: desktopicon; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\target\release\rdp-manager.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\LICENSE"; DestDir: "{app}"; DestName: "LICENSE.txt"

[Icons]
Name: "{autoprograms}\RDP Manager"; Filename: "{app}\rdp-manager.exe"
Name: "{autodesktop}\RDP Manager"; Filename: "{app}\rdp-manager.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\rdp-manager.exe"; Description: "{cm:LaunchProgram,RDP Manager}"; Flags: nowait postinstall skipifsilent
